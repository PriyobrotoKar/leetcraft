---
import { IconBoltFilled } from '@tabler/icons-react';
import { Button } from '@leetcraft/ui/components/button';
---

<section
  class="text-center space-y-12 max-w-5xl mx-auto border rounded-lg py-20"
>
  <div class="space-y-7">
    <div class="flex justify-center gap-2 items-center">
      <IconBoltFilled className="text-green-400" />
      <p class="text-muted-foreground">Get Started</p>
    </div>
    <h2 class="text-5xl font-semibold">Ready to Solve Challenges?</h2>

    <p class="max-w-lg mx-auto text-muted-foreground">
      Join a growing community of developers who learn by doing. No fluff—just
      real practice.
    </p>
  </div>
  <Button> Start Solving Now </Button>
</section>
