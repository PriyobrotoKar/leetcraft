---
import { Button } from '@leetcraft/ui/components/button';
---

<header
  class="flex justify-between border rounded-lg max-w-6xl mt-4 mx-auto items-center p-3"
>
  <div class="flex max-w-20 font-semibold gap-2 text-[1.25rem] leading-tight">
    <img src="/logo.svg" width={48} height={48} alt="Logo" />
    Leet Craft
  </div>

  <nav class="text-base-ui-medium">
    <ul class="flex gap-4">
      <li><a href="/">Home</a></li>
      <li><a href="/about">About</a></li>
      <li><a href="/contact">Contact</a></li>
    </ul>
  </nav>

  <Button variant={'secondary'}> Login </Button>
</header>
