---
import { IconStarFilled } from '@tabler/icons-react';
---

<section class="text-center max-w-7xl space-y-20 mx-auto">
  <div class="space-y-7">
    <img src="/logo.svg" width={64} height={64} class="mx-auto" alt="Logo" />

    <div class="flex justify-center gap-2 items-center">
      <IconStarFilled className="text-yellow-400" />
      <p class="text-muted-foreground">Product Overview</p>
    </div>

    <div class="space-y-5">
      <h2 class="text-5xl font-semibold">LeetCraft at a Glance</h2>
      <p class="max-w-lg mx-auto text-muted-foreground">
        Not just another problem list. A complete, modern environment to code,
        learn, and get better.
      </p>
    </div>
  </div>

  <div>
    <img class="rounded-md mx-auto" src="/platform.jpg" alt="Platform" />
  </div>
</section>
