// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

generator json {
  provider = "prisma-json-types-generator"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdProblems Problem[]    @relation("CreatedProblems")
  solvedProblems  Problem[]    @relation("SolvedProblems")
  submissions     Submission[]
}

model Problem {
  id          String     @id @default(cuid())
  title       String
  description String
  tags        String[]
  difficulty  Difficulty
  structure   String

  /// [TestCase]
  testcases   Json[]
  isValidated Boolean @default(false)

  author   User   @relation("CreatedProblems", fields: [authorId], references: [id])
  authorId String

  solvedBy User[] @relation("SolvedProblems")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  boilerplates Boilerplate[]
  submissions  Submission[]
}

model Boilerplate {
  id         String @id @default(cuid())
  languageId Int
  language   String
  shortCode  String
  longCode   String

  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  problemId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Submission {
  id              String  @id @default(cuid())
  status          Int?
  message         String?
  solution        String
  language        String
  time            Int?
  memory          Int?
  stdin           String?
  stdout          String?
  stderr          String?
  exptectedOutput String?
  testsPassed     Int?

  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  problemId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
